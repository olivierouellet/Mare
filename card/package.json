{
  "name": "mare-tide-card",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "yarn@4.12.0",
  "description": "Lovelace card for Canadian tides (DFO / MPO): every high and low tide, English and French",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "tides",
    "marees"
  ],
  "module": "mare-tide-card.js",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "rollup": "^4.20.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^1.1.1",
    "tslib": "^2.6.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch",
    "build": "yarn clean && yarn lint && yarn typecheck && yarn rollup",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "rollup": "rollup -c"
  }
}
